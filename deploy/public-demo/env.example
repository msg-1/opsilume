# Copy to .env in this directory and fill in every value. Never commit .env.
# Generate secrets on the server, for example: openssl rand -hex 32
DEMO_HOSTNAME=demo.example.org
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
ENCRYPTION_KEY=
# There is no password sign-in on the public demo, for anyone: visitors enter through "Explore the
# demo", and operators work on the server (reset.sh, public-demo.js). Do not set PUBLIC_DEMO_OWNER_PASSWORD;
# setup refuses to run if it is set.
# Optional: investigations per day for the whole demo (default 200).
INVESTIGATION_DAILY_LIMIT=200
# Optional: investigations per visitor session (default 3) and per client address a day (default 10).
DEMO_SESSION_INVESTIGATION_LIMIT=3
DEMO_ADDRESS_DAILY_INVESTIGATION_LIMIT=10
# Optional: the longest one investigation may run, in milliseconds (default 120000; the check allows at most 300000).
INVESTIGATION_TIMEOUT_MS=120000
